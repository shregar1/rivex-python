class RivexServer:
    """Async HTTP server backed by Hyper + Tokio."""

    def __init__(self) -> None: ...
    def add_route(self, method: str, path: str, handler: Callable[..., Any]) -> None: ...
    def add_websocket_route(self, path: str, handler: Callable[..., Any]) -> None: ...
    def run(self, host: str, port: int) -> None: ...

class PyWebSocket:
    """Per-connection WebSocket handle.

    Sync methods that block the calling thread; the GIL is released
    during each block so other Python work runs concurrently. The
    Python ``rivex.WebSocket`` wrapper exposes async versions.
    """

    def recv(self) -> tuple[str, Any] | None: ...
    def send_text(self, data: str) -> None: ...
    def send_bytes(self, data: bytes) -> None: ...
    def close(self, code: int = 1000, reason: str = "") -> None: ...

