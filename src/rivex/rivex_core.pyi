class GenField:
    """Field expression builder for declarative data generation.

    Create with static methods and pass to ``gen_list_json`` / ``gen.list()``.
    """

    @staticmethod
    def index() -> GenField: ...
    @staticmethod
    def fmt(template: str) -> GenField: ...
    @staticmethod
    def repeat(template: str, n: int) -> GenField: ...
    @staticmethod
    def mul(by: int) -> GenField: ...
    @staticmethod
    def add(offset: int) -> GenField: ...
    @staticmethod
    def sub(val: int) -> GenField: ...
    @staticmethod
    def mod_(val: int) -> GenField: ...
    @staticmethod
    def range(start: int, step: int) -> GenField: ...
    @staticmethod
    def cycle(values: list[str]) -> GenField: ...
    @staticmethod
    def null() -> GenField: ...
    @staticmethod
    def choice(values: list[str]) -> GenField: ...
    @staticmethod
    def uuid() -> GenField: ...
    @staticmethod
    def chain(first: Any, second: Any) -> GenField: ...
    @staticmethod
    def cond(pred: Any, then_expr: Any, else_expr: Any) -> GenField: ...
    @staticmethod
    def nested(count: int, schema: dict[str, Any]) -> GenField: ...

class CompiledGen:
    """Pre-compiled generator holding a parsed schema in Rust memory.

    Created once at startup; ``generate()`` writes JSON into a pre-sized
    buffer with zero schema parsing overhead per call.
    """

    def __init__(
        self,
        count: int,
        schema: dict[str, Any],
        wrapper_key: str | None = ...,
    ) -> None: ...
    def generate(self) -> bytes: ...
    def generate_csv(self) -> bytes: ...
    def generate_ndjson(self) -> bytes: ...
    def generate_response(self) -> dict[str, Any]: ...

